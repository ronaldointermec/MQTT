# Dependências (Ignora todas as 4 pastas node_modules de uma vez)
node_modules/
.vite/

# Produção / Compilação (Ignora as pastas de build do frontend e assinante)
dist/
build/

# Arquivos de log (Ignora o leituras_log.txt e logs do npm)
*.log
leituras_log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variáveis de ambiente e segredos (Caso você venha a usar arquivos .env)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Executáveis e binários (Ignora arquivos como o rfid-monitor.exe)
*.exe
*.dll
*.dylib
*.so

# Configurações de ferramentas de desenvolvimento (IDE e SO)
.vscode/
.idea/
.DS_Store
Thumbs.db
